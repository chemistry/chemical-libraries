{
  "name": "@chemistry/chemical-libraries",
  "version": "3.4.0",
  "description": "Open Cheminformatics Libraries",
  "type": "module",
  "author": {
    "name": "Volodymyr Vreshch",
    "url": "https://vreshch.com/"
  },
  "license": "MIT",
  "private": true,
  "keywords": [
    "cheminformatics",
    "chemistry",
    "javascript"
  ],
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chemistry/chemical-libraries.git"
  },
  "homepage": "https://github.com/chemistry/chemical-libraries#readme",
  "bugs": "https://github.com/chemistry/chemical-libraries/issues",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "prebuild": "rm -rf packages/*/dist",
    "build": "npm run build -w @chemistry/common -w @chemistry/elements -w @chemistry/space-groups && npm run build -w @chemistry/math -w @chemistry/formula && npm run build -w @chemistry/molecule",
    "test": "vitest run --coverage",
    "lint": "eslint packages/*/src/ scripts/",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "verify:pack": "node scripts/check-pack.js && tsc -p tools/consumer-check && node tools/consumer-check/smoke.mjs",
    "verify": "npm run type-check && npm run lint && npm run format:check && npm run test && npm run build && npm run verify:pack",
    "clean": "rm -rf packages/*/dist coverage"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "publint": "^0.3.23",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.0.0"
  }
}
